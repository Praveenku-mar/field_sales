  "html": "{%- set shop = frappe.db.get_value(\"Store Connection\", \"Store Connection\", [\"shop_name\", \"store_url\", \"platform\"], as_dict=True) -%}\n{%- set cust = frappe.db.get_value(\"Retailer\", doc.retailer, [\"retailer_name\", \"owner_name\", \"phone\", \"address_line1\", \"address_line2\", \"city\", \"state\", \"pincode\", \"gstin\"], as_dict=True) or {} -%}\n{%- set rep = frappe.db.get_value(\"Sales Rep\", doc.sales_rep, \"full_name\") -%}\n{%- set status_label = {0: \"DRAFT\", 1: \"SUBMITTED\", 2: \"CANCELLED\"}.get(doc.docstatus, \"\") -%}\n<div style=\"font-family: 'Inter', -apple-system, 'Segoe UI', sans-serif; color: #1F1F1F; font-size: 12px; line-height: 1.5;\">\n\n  <div style=\"display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #1F1F1F; padding-bottom: 12px;\">\n    <div>\n      <div style=\"font-size: 20px; font-weight: 700;\">{{ shop.shop_name or \"Field Sales\" }}</div>\n      <div style=\"color: #6B7280; margin-top: 2px;\">{{ shop.store_url or shop.platform or \"\" }}</div>\n    </div>\n    <div style=\"text-align: right;\">\n      <div style=\"font-size: 16px; font-weight: 700; letter-spacing: 0.06em;\">FIELD ORDER</div>\n      <div style=\"margin-top: 2px;\">{{ doc.name }}</div>\n      <span style=\"display: inline-block; margin-top: 6px; padding: 2px 8px; border-radius: 999px; font-size: 10px; font-weight: 600; letter-spacing: 0.08em; border: 1px solid #6B7280; color: #6B7280;\">{{ status_label }}</span>\n    </div>\n  </div>\n\n  <div style=\"display: flex; justify-content: space-between; gap: 24px; margin: 16px 0;\">\n    <div>\n      <div style=\"font-size: 10px; font-weight: 600; letter-spacing: 0.08em; color: #6B7280; margin-bottom: 4px;\">CUSTOMER</div>\n      <div><b>{{ cust.retailer_name or doc.retailer_name or doc.retailer }}</b></div>\n      {% if cust.address_line1 %}<div>{{ cust.address_line1 }}{% if cust.address_line2 %}, {{ cust.address_line2 }}{% endif %}</div>{% endif %}\n      {% if cust.city %}<div>{{ [cust.city, cust.state, cust.pincode]|join(\", \") }}</div>{% endif %}\n      {% if cust.phone %}<div>{{ cust.phone }}</div>{% endif %}\n      {% if cust.gstin %}<div style=\"color: #6B7280;\">GSTIN: {{ cust.gstin }}</div>{% endif %}\n    </div>\n    <div style=\"text-align: right;\">\n      <div style=\"font-size: 10px; font-weight: 600; letter-spacing: 0.08em; color: #6B7280; margin-bottom: 4px;\">ORDER DETAILS</div>\n      <div>Date: {{ frappe.utils.formatdate(doc.order_date) }}</div>\n      <div>Sales Rep: {{ rep or doc.sales_rep or \"—\" }}</div>\n      {% if doc.visit %}<div>Visit: {{ doc.visit }}</div>{% endif %}\n      {% if doc.tax_percent %}<div>Tax: {{ doc.tax_percent }}%</div>{% endif %}\n    </div>\n  </div>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-top: 4px;\">\n    <thead>\n      <tr>\n        <th style=\"text-align: left; font-size: 10px; letter-spacing: 0.06em; color: #6B7280; border-bottom: 1px solid #D1D5DB; padding: 6px 8px; width: 30px;\">#</th>\n        <th style=\"text-align: left; font-size: 10px; letter-spacing: 0.06em; color: #6B7280; border-bottom: 1px solid #D1D5DB; padding: 6px 8px;\">Product</th>\n        <th style=\"text-align: left; font-size: 10px; letter-spacing: 0.06em; color: #6B7280; border-bottom: 1px solid #D1D5DB; padding: 6px 8px; width: 110px;\">SKU</th>\n        <th style=\"text-align: right; font-size: 10px; letter-spacing: 0.06em; color: #6B7280; border-bottom: 1px solid #D1D5DB; padding: 6px 8px; width: 50px;\">Qty</th>\n        <th style=\"text-align: right; font-size: 10px; letter-spacing: 0.06em; color: #6B7280; border-bottom: 1px solid #D1D5DB; padding: 6px 8px; width: 80px;\">Rate</th>\n        <th style=\"text-align: right; font-size: 10px; letter-spacing: 0.06em; color: #6B7280; border-bottom: 1px solid #D1D5DB; padding: 6px 8px; width: 90px;\">Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.items %}\n      <tr>\n        <td style=\"padding: 7px 8px; border-bottom: 1px solid #EDEDED; vertical-align: top;\">{{ loop.index }}</td>\n        <td style=\"padding: 7px 8px; border-bottom: 1px solid #EDEDED; vertical-align: top;\">\n          <span style=\"font-weight: 600;\">{{ item.product_title or item.product }}</span>\n          {% if item.variant_title %}<span style=\"font-size: 10px; color: #6B7280;\"> — {{ item.variant_title }}</span>{% endif %}\n        </td>\n        <td style=\"padding: 7px 8px; border-bottom: 1px solid #EDEDED; vertical-align: top; font-size: 10px; color: #6B7280; font-family: 'JetBrains Mono', monospace;\">{{ item.sku or \"—\" }}</td>\n        <td style=\"padding: 7px 8px; border-bottom: 1px solid #EDEDED; vertical-align: top; text-align: right; white-space: nowrap;\">{{ frappe.utils.flt(item.qty, 3) }}</td>\n        <td style=\"padding: 7px 8px; border-bottom: 1px solid #EDEDED; vertical-align: top; text-align: right; white-space: nowrap;\">{{ frappe.utils.fmt_money(item.rate, currency=\"INR\") }}</td>\n        <td style=\"padding: 7px 8px; border-bottom: 1px solid #EDEDED; vertical-align: top; text-align: right; white-space: nowrap;\">{{ frappe.utils.fmt_money(item.amount, currency=\"INR\") }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <table style=\"margin-left: auto; margin-top: 12px; width: 280px;\">\n    <tr>\n      <td style=\"padding: 4px 8px;\">Total Qty</td>\n      <td style=\"padding: 4px 8px; text-align: right; white-space: nowrap;\">{{ frappe.utils.flt(doc.total_qty, 3) }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 4px 8px;\">Net Total</td>\n      <td style=\"padding: 4px 8px; text-align: right; white-space: nowrap;\">{{ frappe.utils.fmt_money(doc.net_total, currency=\"INR\") }}</td>\n    </tr>\n    {% if doc.discount_amount %}\n    <tr>\n      <td style=\"padding: 4px 8px;\">Discount</td>\n      <td style=\"padding: 4px 8px; text-align: right; white-space: nowrap;\">− {{ frappe.utils.fmt_money(doc.discount_amount, currency=\"INR\") }}</td>\n    </tr>\n    {% endif %}\n    {% if doc.tax_amount %}\n    <tr>\n      <td style=\"padding: 4px 8px;\">Tax ({{ doc.tax_percent }}%)</td>\n      <td style=\"padding: 4px 8px; text-align: right; white-space: nowrap;\">{{ frappe.utils.fmt_money(doc.tax_amount, currency=\"INR\") }}</td>\n    </tr>\n    {% endif %}\n    <tr>\n      <td style=\"border-top: 2px solid #1F1F1F; margin-top: 4px; padding: 8px 8px 4px; font-weight: 700; font-size: 14px;\">Grand Total</td>\n      <td style=\"border-top: 2px solid #1F1F1F; padding: 8px 8px 4px; text-align: right; white-space: nowrap; font-weight: 700; font-size: 14px;\">{{ frappe.utils.fmt_money(doc.grand_total, currency=\"INR\") }}</td>\n    </tr>\n  </table>\n\n  <div style=\"margin-top: 28px; padding-top: 10px; border-top: 1px solid #EDEDED; font-size: 10px; color: #6B7280; display: flex; justify-content: space-between;\">\n    <span>{{ frappe.utils.formatdate(frappe.utils.nowdate()) }}</span>\n    <span>Generated from Field Sales</span>\n  </div>\n</div>",
